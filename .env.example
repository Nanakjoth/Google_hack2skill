# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required to enable the LLM triage path. Without it, Agent 1 falls back to
# the built-in case profiles and everything else still works.
# Get one at https://aistudio.google.com/apikey
# Keys issued by the current AI Studio console start with "AQ.A"; older ones
# start with "AIza". Either is fine — the value is never inspected.
GOOGLE_API_KEY=AIza_REPLACE_ME_paste_your_own_key_here

# Optional overrides
LLM_MODEL=gemini-3-flash-preview
# Tried in order when one is at capacity. Every entry must accept response_schema.
LLM_FALLBACK_MODELS=gemini-3.1-flash-lite
# First retry wait in seconds, doubled each attempt.
LLM_BACKOFF_BASE=2.5
LLM_TIMEOUT=30
LLM_RETRIES=2

# Reasoning tokens spent before the JSON is emitted. 0 turns thinking off: the
# severity rules are stated explicitly in the prompt, so this reads a report
# rather than inferring. Raise it for harder reports, and raise LLM_MAX_TOKENS
# with it — a truncated response fails schema validation and falls back to rules.
LLM_THINKING_BUDGET=0
LLM_MAX_TOKENS=1024

# Approximate Gemini per-1M-token rates (USD) used by the eval cost estimate.
# WARNING: these defaults are the old 2.5 Flash tier. The 3.x Flash tier is
# priced differently, so any cost figure this repo reports is only as good as
# the numbers here. Check current pricing and update before quoting a cost.
LLM_IN_COST=0.30
LLM_OUT_COST=2.50

# Comma-separated allowed origins, or "none" to disable CORS. Dev default is "*".
# Set this to your real frontend origin before deploying anywhere public.
ALLOWED_ORIGINS=*
