# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required to enable the LLM triage path. Without it, Agent 1 falls back to
# the built-in case profiles and everything else still works.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_REPLACE_ME_paste_your_own_key_here

# Optional overrides
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT=20
LLM_RETRIES=2

# Approximate Groq per-1M-token rates (USD) used by the eval cost estimate.
# Check current pricing and update these if the model changes.
LLM_IN_COST=0.59
LLM_OUT_COST=0.79

# Comma-separated allowed origins, or "none" to disable CORS. Dev default is "*".
# Set this to your real frontend origin before deploying anywhere public.
ALLOWED_ORIGINS=*
